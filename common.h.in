#ifndef NGX_HEALTHCHECK_INTERNAL_H
#define NGX_HEALTHCHECK_INTERNAL_H

#include <nginx.h>
#include <ngx_core.h>
#include <ngx_http.h>
#include "ngx_healthcheck_common.h"
#include "runtime/ngx_healthcheck_state.h"

/* 检查类型沿用既有共享身份编码。 */
#define NGX_CHECK_TYPE_TCP  0x0001
#define NGX_CHECK_TYPE_UDP  0x0004
#define NGX_CHECK_KEEPALIVE_REQUESTS_DEFAULT  10

typedef struct ngx_upstream_check_peer_s ngx_upstream_check_peer_t;
typedef struct ngx_upstream_check_peers_s ngx_upstream_check_peers_t;
typedef struct ngx_healthcheck_runtime_s ngx_healthcheck_runtime_t;
typedef struct ngx_healthcheck_probe_s ngx_healthcheck_probe_t;

/* 协议描述由 HTTP/Stream 的配置解析共同使用。 */
typedef struct {
    ngx_uint_t  type;
    ngx_str_t   name;
    ngx_str_t   default_send;
} ngx_check_conf_t;

/* 每个 upstream 的检查参数，配置完成后由所属 cycle 持有。 */
typedef struct ngx_upstream_check_srv_conf_s {
    ngx_uint_t        port;
    ngx_uint_t        fall_count;
    ngx_uint_t        rise_count;
    ngx_msec_t        check_interval;
    ngx_msec_t        check_timeout;
    ngx_uint_t        check_keepalive_requests;
    ngx_check_conf_t *check_type_conf;
    ngx_str_t         send;
    ngx_uint_t        default_down;
    ngx_flag_t        tcp_reuse;
} ngx_upstream_check_srv_conf_t;

/* 后端配置及本进程调度入口；单轮 I/O 数据按实际执行职责延迟分配。 */
struct ngx_upstream_check_peer_s {
    ngx_uint_t                       index;
    ngx_uint_t                       max_busy;
    ngx_str_t                       *upstream_name;
    ngx_addr_t                      *check_peer_addr;
    ngx_addr_t                      *peer_addr;
    ngx_upstream_check_srv_conf_t    *conf;
    ngx_upstream_check_peer_shm_t    *shm;
    ngx_healthcheck_runtime_t        *runtime;
    ngx_healthcheck_probe_t          *probe;
    ngx_event_t                      check_ev;
};

/* 配置、共享区及运行上下文通过同一个 cycle 对象关联。 */
struct ngx_upstream_check_peers_s {
    ngx_str_t                        check_shm_name;
    ngx_array_t                      peers;
    ngx_upstream_check_peers_shm_t   *peers_shm;
    ngx_cycle_t                     *cycle;
    ngx_uint_t                       generation;
    ngx_uint_t                       module;
    ngx_uint_t                       workers;
    ngx_healthcheck_runtime_t        *runtime;
};

/* 两个协议模块共用 main 配置布局和解析入口。 */
typedef struct {
    ngx_uint_t                       check_shm_size;
    ngx_upstream_check_peers_t       *peers;
} ngx_healthcheck_main_conf_t;

typedef struct ngx_healthcheck_identity_index_s ngx_healthcheck_identity_index_t;

/* 从旧共享状态建立完整 peer 身份索引，匹配结果按一对一方式消费。 */
ngx_healthcheck_identity_index_t *ngx_healthcheck_identity_index_create(
    ngx_pool_t *pool, ngx_upstream_check_peers_shm_t *peers_shm);
ngx_upstream_check_peer_shm_t *ngx_healthcheck_identity_index_take(
    ngx_healthcheck_identity_index_t *index, ngx_upstream_check_peer_t *peer);

/* 在有效旧 cycle 中查找同模块共享数据。 */
ngx_upstream_check_peers_shm_t *ngx_healthcheck_find_latest_peers_shm(
    ngx_cycle_t *cycle, void *tag);

/* 将配置中的完整身份复制到共享 slab。 */
ngx_int_t ngx_healthcheck_copy_shm_identity(ngx_slab_pool_t *shpool,
    ngx_upstream_check_peer_shm_t *peer_shm, ngx_upstream_check_peer_t *peer);

#endif
