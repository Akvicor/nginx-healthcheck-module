
/* module internal common header */

#include <nginx.h>
#include <ngx_core.h>
#include <ngx_http.h>
#include "ngx_healthcheck_common.h"

typedef struct ngx_upstream_check_peer_s ngx_upstream_check_peer_t;
typedef struct ngx_upstream_check_srv_conf_s ngx_upstream_check_srv_conf_t;

#define NGX_CHECK_KEEPALIVE_REQUESTS_DEFAULT 10

typedef ngx_int_t (*ngx_upstream_check_packet_init_pt)
        (ngx_upstream_check_peer_t *peer);
typedef ngx_int_t (*ngx_upstream_check_packet_parse_pt)
        (ngx_upstream_check_peer_t *peer);
typedef void (*ngx_upstream_check_packet_clean_pt)
        (ngx_upstream_check_peer_t *peer);


typedef struct {
    ngx_uint_t                               type;

    ngx_str_t                                name;

    ngx_str_t                                default_send;

    /* not used for TCP/UDP */
    ngx_uint_t                               default_status_alive;

    ngx_event_handler_pt                     send_handler;
    ngx_event_handler_pt                     recv_handler;

    ngx_upstream_check_packet_init_pt   init;
    ngx_upstream_check_packet_parse_pt  parse;
    ngx_upstream_check_packet_clean_pt  reinit;

    unsigned need_keepalive;
} ngx_check_conf_t;

struct ngx_upstream_check_srv_conf_s {
    ngx_uint_t                               port;
    ngx_uint_t                               fall_count;
    ngx_uint_t                               rise_count;
    ngx_msec_t                               check_interval;
    ngx_msec_t                               check_timeout;
    ngx_uint_t                               check_keepalive_requests;

    ngx_check_conf_t                        *check_type_conf;
    ngx_str_t                                send;

    ngx_uint_t                               default_down;
    ngx_flag_t                               tcp_reuse;
};

typedef struct {
    ngx_shmtx_t                              mutex;
#if (nginx_version >= 1002000)
    ngx_shmtx_sh_t                           lock;
#else
    ngx_atomic_t                             lock;
#endif

    ngx_pid_t                                owner;

    ngx_msec_t                               access_time;

    ngx_uint_t                               fall_count;
    ngx_uint_t                               rise_count;

    ngx_uint_t                               busyness;
    ngx_uint_t                               access_count;

    struct sockaddr                         *sockaddr;
    socklen_t                                socklen;

    ngx_atomic_t                             down;          //current status.

    ngx_msec_t                               last_check_delay;    // 最后一次检查的延迟(毫秒)
    ngx_msec_t                               avg_check_delay;     // 平均延迟(毫秒)
    ngx_msec_t                               max_check_delay;     // 最大延迟(毫秒)
    ngx_msec_t                               min_check_delay;     // 最小延迟(毫秒)
    uint64_t                                 delay_total;
    uint64_t                                 delay_sample_count;  // 延迟采样次数

    ngx_str_t                                upstream_name;
    struct sockaddr                         *check_sockaddr;
    socklen_t                                check_socklen;
    ngx_uint_t                               check_type;
    u_char                                   padding[64];
} ngx_upstream_check_peer_shm_t;

#define NGX_HEALTHCHECK_SHM_MAGIC            0x48434b31U
#define NGX_HEALTHCHECK_SHM_VERSION          1

typedef struct {
    uint32_t                                 magic;
    uint32_t                                 version;
    ngx_uint_t                               generation;// current process generation(==reload_num +1)
    ngx_uint_t                               number;

    /* ngx_upstream_check_status_peer_t */
    ngx_upstream_check_peer_shm_t       peers[1]; //hack: peer[0]
} ngx_upstream_check_peers_shm_t;
     /* followed with (peers_num-1)*ngx_upstream_check_peer_shm_t dynamicly,*/
    /* so we can ref by peers_shm->peers[0],[1],... */



struct ngx_upstream_check_peer_s {
    ngx_flag_t                               state;
    ngx_uint_t                               index;
    ngx_uint_t                               max_busy;
    ngx_str_t                               *upstream_name;
    ngx_addr_t                              *check_peer_addr;
    ngx_addr_t                              *peer_addr;
    ngx_event_t                              check_ev;
    ngx_event_t                              check_timeout_ev;
    ngx_peer_connection_t                    pc;
    ngx_flag_t                               check_owner;

    void                                    *check_data;
    ngx_event_handler_pt                     send_handler;
    ngx_event_handler_pt                     recv_handler;

    ngx_upstream_check_packet_init_pt   init; //zhoucx: function ptr
    ngx_upstream_check_packet_parse_pt  parse;
    ngx_upstream_check_packet_clean_pt  reinit;

    ngx_upstream_check_peer_shm_t      *shm;
    ngx_upstream_check_srv_conf_t      *conf;

    ngx_msec_t                         check_start_time;    // 本轮检查开始时间
};

typedef struct {
    ngx_str_t                                check_shm_name;
    /* peers include ngx_upstream_check_peer_t item*/
    ngx_array_t                              peers;
    ngx_upstream_check_peers_shm_t     *peers_shm;
} ngx_upstream_check_peers_t;

typedef struct ngx_healthcheck_identity_index_s ngx_healthcheck_identity_index_t;

/* 从旧共享状态建立完整 peer 身份索引，匹配结果按一对一方式消费。 */
ngx_healthcheck_identity_index_t *ngx_healthcheck_identity_index_create(
    ngx_pool_t *pool, ngx_upstream_check_peers_shm_t *peers_shm);
ngx_upstream_check_peer_shm_t *ngx_healthcheck_identity_index_take(
    ngx_healthcheck_identity_index_t *index, ngx_upstream_check_peer_t *peer);

/* 在旧 cycle 中扫描并返回同模块最近一次有效的共享状态。 */
ngx_upstream_check_peers_shm_t *ngx_healthcheck_find_latest_peers_shm(
    ngx_cycle_t *cycle, void *tag);

/* 将当前配置中的完整 peer 身份复制到当前共享 slab。 */
ngx_int_t ngx_healthcheck_copy_shm_identity(ngx_slab_pool_t *shpool,
    ngx_upstream_check_peer_shm_t *peer_shm,
    ngx_upstream_check_peer_t *peer);
